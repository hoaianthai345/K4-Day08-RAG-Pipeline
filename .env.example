# OpenRouter API Key (Khuyên dùng cho bài lab - có model free :free)
OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI API Key + embedding API (required for Task 4/5 in the current pipeline)
OPENAI_API_KEY=sk-proj-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 1536 for text-embedding-3-small; 3072 for text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536

# Generation model routing
LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini

# Second-stage reranker after RRF. "openai" uses the key above; it falls back
# to RRF ordering if the API is unavailable. Alternatives: cross_encoder, mmr.
RERANK_METHOD=openai
OPENAI_RERANK_MODEL=gpt-4o-mini

# Gemini API Key (Tùy chọn - fallback nếu OpenRouter và OpenAI đều không có/hết quota)
# GEMINI_API_KEY=...

# PageIndex API Key (Tùy chọn - dùng cho Task 8: Vectorless RAG fallback)
# PAGEINDEX_API_KEY=pix_...

# Jina API Key (Tùy chọn - dùng cho Task 7: Cross-encoder reranking via Jina API)
# JINA_API_KEY=jina_...
